# ---------------------------------------------------------------------
# LLM (any OpenAI-compatible endpoint: OpenAI, Groq, Together, Ollama...)
# ---------------------------------------------------------------------
OPENAI_API_KEY=
# Optional - only needed for non-OpenAI providers
# OPENAI_BASE_URL=https://api.openai.com/v1
LLM_ENABLED=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
EMBEDDING_MODEL=text-embedding-3-small

# --- Local model example (Ollama) ---
# OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:latest
# EMBEDDING_MODEL=nomic-embed-text
# Note: if you change embedding provider/model, delete data/vectorstore/faiss_index/ and re-upload documents.

# ---------------------------------------------------------------------
# Web search tool (https://tavily.com - free tier available)
# ---------------------------------------------------------------------
TAVILY_API_KEY=

# ---------------------------------------------------------------------
# RAG / agent behaviour
# ---------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
MAX_RETRIES=1
MAX_STEPS=8
MAX_TOOL_CALLS=3

# ---------------------------------------------------------------------
# Servers
# ---------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
BACKEND_URL=http://127.0.0.1:8000
CORS_ORIGINS=*
